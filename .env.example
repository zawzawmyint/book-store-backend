PORT=4000
NODE_ENV=development
# SQLite is the development/test default; production requires postgresql.
DB_PROVIDER=sqlite
DATABASE_PATH=./data/book-store.sqlite
# For PostgreSQL, set DB_PROVIDER=postgresql and apply db:migrate before startup.
# DATABASE_URL=postgresql://app_user:REPLACE_ME@db.example.com:5432/book_store
# Each process has its own pool; total pools must fit the server connection limit.
PG_POOL_MAX=10
# Defaults: disable in development/test; verify-full mandatory in production.
# PG_TLS_MODE=verify-full
# PG_CA_FILE=./certificates/postgresql-ca.pem
FRONTEND_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
# Optional: IP address of a trusted reverse proxy that overwrites X-Real-IP.
# AUTH_TRUSTED_PROXY_IP=
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Delivery remains disabled until store coverage and fee are chosen.
DELIVERY_ENABLED=false
# Explicit demo values only (USD 5 per order):
# DELIVERY_COUNTRY_CODES=US
# DELIVERY_FEE_CENTS=500

# SMTP is required by the production email worker. Ethereal is development-only; supply your own account.
# Use port 587 with SMTP_SECURE=false (mandatory STARTTLS), or 465 with true.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=authorized-sender@example.com
# SMTP_REPLY_TO=help@example.com

# Durable email delivery. Development/test may retain inline delivery; production requires queued.
# The API records encrypted work in the database. For development, run
# `bun run email:worker` separately; production runs the compiled worker after build:
# `bun run email:worker:start`. Do not put real values in this file.
# EMAIL_DELIVERY_MODE=queued
# EMAIL_ORDER_NOTIFICATIONS_ENABLED=true
# REDIS_URL=rediss://:REPLACE_ME@redis.example.com:6380
# EMAIL_QUEUE_PREFIX=quiet-shelf-production
# EMAIL_PAYLOAD_KEYS={"key-2026-10":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
# EMAIL_PAYLOAD_ACTIVE_KEY_ID=key-2026-10
# EMAIL_DEDUPE_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# EMAIL_AUTH_CONCURRENCY=2
# EMAIL_ORDER_CONCURRENCY=2
# EMAIL_WORKER_HEALTH_PORT=4010
