PORT=4000
NODE_ENV=development
# SQLite is the development/test default; production requires postgresql.
DB_PROVIDER=sqlite
DATABASE_PATH=./data/book-store.sqlite
# For PostgreSQL, set DB_PROVIDER=postgresql and apply db:migrate before startup.
# DATABASE_URL=postgresql://app_user:REPLACE_ME@db.example.com:5432/book_store
# Each process has its own pool; total pools must fit the server connection limit.
PG_POOL_MAX=10
# Defaults: disable in development/test; verify-full mandatory in production.
# PG_TLS_MODE=verify-full
# PG_CA_FILE=./certificates/postgresql-ca.pem
FRONTEND_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
# Optional: IP address of a trusted reverse proxy that overwrites X-Real-IP.
# AUTH_TRUSTED_PROXY_IP=
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
